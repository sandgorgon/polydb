// Users, roles and permissions (spec/rhizome.md §11).

define kind Order { item: text, total: decimal(10,2) };
define kind Note { text: text };
define kind Secret { code: text };
create Order @o1 { item: "pen", total: 1.50d };
create Note @n1 { text: "hello" };
create Secret @s1 { code: "xyzzy" };
create @loose { text: "kindless" };
relate @n1 ~about~> @o1;
relate @n1 ~about~> @s1;
create database hr;

create user ramon password "correct horse";
create user eve password "battery staple";
create role analyst;
grant read on database test to analyst;
grant write on kind Order to analyst;
grant analyst to ramon;
grant read, relate on kind test.Note to eve;
grant read on kind Order to eve;

create user ramon password "again";
// error constraint: a user or role named ramon already exists
grant analyst to nobody;
// error not_found: no user or role nobody
grant read on kind Nope to eve;
// error not_found: no kind Nope in database test
grant flying on database test to eve;
// error syntax: unknown permission flying

show users;
// => "admin" | false | 0 | ""
// => "eve" | true | 0 | ""
// => "ramon" | true | 0 | "analyst"
show roles;
// => "analyst" | "ramon"
show grants for ramon;
// => "analyst" | "read" | "database test"
// => "analyst" | "write" | "kind test.Order"

alter user ramon add key "3F9A00000000000000000000000000000000000000000000000000000000C41E" as "laptop";
show keys for ramon;
// => "3f9a00000000000000000000000000000000000000000000000000000000c41e" | "laptop"
alter user eve add key "3f9a00000000000000000000000000000000000000000000000000000000c41e";
// error constraint: registered to another user
alter user ramon add key "short";
// error constraint: 64 lowercase hex

// ramon: read on the database, write on Order.
// as ramon
show databases;
// => "test" | "admin" | t"2026-11-22T12:00:00Z" | {} | null
use hr;
// error permission: you don't have permission on database hr
find o | sort o::kind | show o::kind;
// => null
// => "Note"
// => "Order"
// => "Secret"
update @o1 set total = 2.00d;
// error not_found: no handle @o1
find Order o | update o set total = 2.00d;
// affected: 1
find Note n | update n set text = "changed";
// error permission: you don't have write permission on kind Note
create Note { text: "new" };
// error permission: you don't have write permission on kind Note
create @x { a: 1 };
// error permission: you don't have write permission on kindless entities
define kind Mine { a: int };
// error permission: you don't have define permission on database test
create user mallory password "x";
// error permission: create user needs admin
show users;
// error permission: show users needs admin
show grants;
// => "analyst" | "read" | "database test"
// => "analyst" | "write" | "kind test.Order"
alter user ramon password "new password";
alter user eve password "hacked";
// error permission: only admins can change another user

// eve: read on Note and Order, relate on Note; nothing on Secret or kindless.
// as eve
find o | sort o::kind | show o::kind;
// => "Note"
// => "Order"
find Secret s;
// error permission: you don't have read permission on kind Secret
find Note n | follow n ~about~> x | show x::kind;
// => "Order"
find Note n | show n.text, degree(n, "about");
// => "hello" | 1
describe kind Secret;
// error permission: you don't have read permission on kind Secret
show kinds;
// => "Note" | "extensible" | 1 | 1 | ""
// => "Order" | "extensible" | 2 | 1 | ""
find Note n | follow n ~about~> Order o | unrelate n ~about~> o;
// affected: 1
find Order o | update o set total = 9.00d;
// error permission: you don't have write permission on kind Order

// Revoking takes effect at once.
// as admin
revoke analyst from ramon;
revoke read on kind Order from eve;
revoke read on kind Order from eve;
// error not_found: eve doesn't have that permission
drop role analyst;
drop user admin;
// error constraint: can't be dropped
revoke admin on server from admin;
// error constraint: keeps admin
// as ramon
use test;
// error permission: you don't have permission on database test
// as admin
drop user eve;
show users;
// => "admin" | false | 0 | ""
// => "ramon" | true | 1 | ""
