// The spec's running example (spec/rhizome.md §5–§7).

define kind Person "A human being" {
  name     : text                         "Full name"
  email    : text unique                  "Login email"
  age      : int? check age >= 0
  joined   : date default today()
  tags     : set<text> default {}
  manager  : ref<Person>? on delete restrict
  inbox    : queue.priority<text>
  salary   : decimal(12,2)?
};
define kind Company { name: text };
define relation knows from Person to Person "Personal acquaintance" { since: int? };
define relation works_at from Person to Company max out 1;

create Person @alice { name: "Alice", email: "a@x.io", age: 34, tags: {"eng"} };
// affected: 1
create Person @bob { name: "Bob", email: "b@x.io", age: 41, manager: @alice };
create Person @carol { name: "Carol", email: "c@x.io", age: 52, tags: {"eng", "ops"} }
  add hobby : text = "chess" doc "Main hobby";
create Person @dan { name: "Dan", email: "d@x.io", age: 38, tags: {"eng"} };
create Company @acme { name: "Acme" };
create @n { title: "Loose note", body: "no kind" };

relate @alice ~knows{since: 2019}~> @bob;
relate @bob ~knows{since: 1985}~> @carol;
relate @carol ~knows~> @dan;
relate @alice ~works_at~> @acme;
relate @dan ~works_at~> @acme;

// The complete example (§7.4), adapted to this data.
find Person p
  | where p.age > 30 and "eng" in p.tags
  | follow p ~works_at~> Company c
  | follow p ~knows*1..3~> Person fof
  | match fof ~works_at~> c
  | distinct p, fof
  | sort p.name
  | show p.name, fof.name as colleague, c.name as company
  | limit 50;
// => "Alice" | "Dan" | "Acme"

// Typos are caught, with suggestions.
create Person { name: "Eve", emial: "e@x.io" };
// error unknown_field: no field emial (did you mean email?)
update @alice set titel = "x";
// error unknown_field: titel
FIND Person p;
// error syntax: keywords are lowercase: did you mean find?
create Person { name: "Eve", email: "a@x.io" };
// error constraint: unique
update @alice set age = -1;
// error constraint: check failed for age
create Person { name: "Eve", email: "e@x.io", age: 1.5 };
// error type: 1.5 (float) can't be stored as int?

find Person p | sort p.name | show p.name, p.joined, p.tags;
// => "Alice" | d"2026-11-22" | {"eng"}
// => "Bob" | d"2026-11-22" | {}
// => "Carol" | d"2026-11-22" | {"eng", "ops"}
// => "Dan" | d"2026-11-22" | {"eng"}

update @alice set age = 35, email = "alice@x.io";
update @alice set age += 1;
update @alice set tags ++= {"ops"}, tags --= {"eng"};
update @alice set name ++= " Jr.";
update @alice set ::labels ++= {"vip"};
find @alice as p | show p.name, p.age, p.email, p.tags, p::labels;
// => "Alice Jr." | 36 | "alice@x.io" | {"ops"} | {"vip"}

update @n set title = "Renamed note";
update @n set titel = "x";
// error unknown_field: no field titel (did you mean title?)
update @n add pinned : bool = true, scores : list<int> = [1, 2];
update @n add attrs = {k: "v"};
update @n set scores[0] = 10, attrs["k"] = "w";
find @n as x | show x.title, x.pinned, x.scores, x.attrs, x::kind;
// => "Renamed note" | true | [10, 2] | {"k": "w"} | null

// Restrict refs block a delete.
delete @alice;
// error constraint: restrict


find Person p | follow p ~knows r~> Person f | where r.since < 1990 | show p.name, f.name;
// => "Bob" | "Carol"
find Person p | follow path pth = p ~knows*~> f | where p.name = "Bob" | sort len(pth) | show len(pth), pth;
// => 1 | "Bob" ~knows~> "Carol"
// => 2 | "Bob" ~knows~> "Carol" ~knows~> "Dan"
find Person p | group by "ops" in p.tags as ops | sort ops | show ops, count() as n, avg(p.age) as avg_age;
// => false | 2 | 39.5d
// => true | 2 | 44d
find Person p | show count(), min(p.age), max(p.age), sum(p.salary);
// => 4 | 36 | 52 | null
find Person p | where p.manager = @alice | show p.name, p.manager.name;
// => "Bob" | "Alice Jr."
find Person p | where p.hobby::declared = false | show p.name, p.hobby, p.hobby::doc;
// => "Carol" | "chess" | "Main hobby"

// Pipelines can end with a data step.
find Person p | where p.age > 50 | update p set ::labels ++= {"senior"};
// affected: 1
find Person p | where p::labels has "senior" | show p.name;
// => "Carol"
find Person p | follow p ~knows r~> f | where r.since < 1990 | unrelate r;
// affected: 1
find @bob as p | follow p ~knows~> f | show f.name;
// => (none)

// Queues.
push @alice.inbox "low" priority 1;
push @alice.inbox "urgent" priority 9;
find @alice as p | show peek(p.inbox), len(p.inbox), items(p.inbox);
// => "urgent" | 2 | ["urgent", "low"]
pop @alice.inbox;
// => "urgent"
pop 10 from @alice.inbox;
// => ["low"]
pop @alice.inbox;
// => null
