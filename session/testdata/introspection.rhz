// describe, show and explain (spec/rhizome.md §12).

define kind Person "A human being" {
  name  : text "Full name"
  email : text unique
  age   : int? check age >= 0
  boss  : ref<Person>? on delete restrict
};
define kind Company closed { name: text };
define relation works_at from Person to Company max out 1 "Employment" { since: date? };
define format contacts : csv header "Address book";
define format staff : csv header { name: text, email: text at 4, status: text default "active" };
define index person_age on Person(age);
define unique index person_email on Person(email);

create Person @ann { name: "Ann", email: "ann@x.io", age: 30 };
create Person @bob { name: "Bob", email: "bob@x.io", boss: @ann } add nick : text = "Bobby" doc "Nickname";
create Company @acme { name: "Acme" };
relate @ann ~works_at{since: d"2020-01-01"}~> @acme;
relate @bob.nick ~likes~> @ann;

describe kind Person;
// => "kind" | "Person" | "extensible" | "2 entities" | "A human being"
// => "field" | "name" | "text" | "" | "Full name"
// => "field" | "email" | "text" | "unique" | ""
// => "field" | "age" | "int?" | "check age >= 0" | ""
// => "field" | "boss" | "ref<Person>?" | "on delete restrict" | ""
// => "index" | "person_age" | "index" | "age" | ""
// => "index" | "person_email" | "unique" | "email" | ""
describe kind Company;
// => "kind" | "Company" | "closed" | "1 entity" | ""
// => "field" | "name" | "text" | "" | ""
describe relation works_at;
// => "relation" | "works_at" | "from Person to Company" | "1 relation, max out 1" | "Employment"
// => "property" | "since" | "date?" | "" | ""
describe relation likes;
// => "relation" | "likes" | "from any to any" | "1 relation, not defined" | ""
describe format staff;
// => "format" | "staff" | "csv" | "header" | ""
// => "column" | "name" | "text" | "" | ""
// => "column" | "email" | "text" | "at 4" | ""
// => "column" | "status" | "text" | "default \"active\"" | ""
describe format contacts;
// => "format" | "contacts" | "csv" | "header" | "Address book"
describe format json;
// => "format" | "json" | "base format" | "" | "built in"
describe index person_age;
// => "index" | "person_age" | "index" | "on Person(age), ready" | ""
describe kind Persn;
// error not_found: no kind Persn (did you mean Person?)

show kinds;
// => "Company" | "closed" | 1 | 1 | ""
// => "Person" | "extensible" | 4 | 2 | "A human being"
show relations;
// => "likes" | "any" | "any" | false | 1 | ""
// => "works_at" | "Person" | "Company" | true | 1 | "Employment"
show formats;
// => "csv" | null | "built in"
// => "json" | null | "built in"
// => "tsv" | null | "built in"
// => "xml" | null | "built in"
// => "contacts" | "csv" | "Address book"
// => "staff" | "csv" | ""
show indexes;
// => "person_age" | "Person" | "index" | "age" | "ready"
// => "person_email" | "Person" | "unique" | "email" | "ready"
show stats;
// => "entities" | 3
// => "kind Company" | 1
// => "kind Person" | 2
// => "relations" | 2
// => "relation likes" | 1
// => "relation works_at" | 1
show stats kind Person;
// => "name" | "text" | 2 | 0 | 2
// => "email" | "text" | 2 | 0 | 2
// => "age" | "int?" | 1 | 0 | 1
// => "boss" | "ref<Person>?" | 1 | 0 | 1

explain find Person p | where p.age > 20 | show p.name;
// => "find" | "p: index person_age for p.age > 20" | 1
// => "where" | "where p.age > 20 (checked at the source)" | null
// => "show" | "show p.name" | null
explain find p | follow p ~nope~> q;
// warning: no relation of type nope has been created yet
// => "find" | "p: scan every entity" | 3
// => "follow" | "follow p ~nope~> q" | null
// => "warning" | "no relation of type nope has been created yet" | null
// => "warning" | "p scans every entity in the database; give it a kind to read fewer" | null
explain find Person p, Company c | show count();
// => "find" | "c: scan kind Company" | 1
// => "find" | "p: scan kind Person" | 2
// => "show" | "show count() (aggregates every row)" | null
// => "warning" | "no condition links p to c, so every combination is formed (a cross product)" | null
// The planner's choices (§7.5): each variable's path and estimate.
explain find Person p | where p.email = "bob@x.io" | show p.name;
// => "find" | "p: unique field email for p.email = \"bob@x.io\"" | 1
// => "where" | "where p.email = \"bob@x.io\" (checked at the source)" | null
// => "show" | "show p.name" | null
explain find Person p | where p = @ann | show p.name;
// => "find" | "p: lookup for p = @ann" | 1
// => "where" | "where p = @ann (checked at the source)" | null
// => "show" | "show p.name" | null
explain find Person p, Person b | where b.boss = p and p.age = 30 | show b.name;
// => "find" | "p: index person_age for p.age = 30" | 1
// => "find" | "b: scan kind Person" | 2
// => "where" | "where b.boss = p and p.age = 30 (checked at the source)" | null
// => "show" | "show b.name" | null
explain find Person p | where p.age > 0 | sort p.age desc | limit 1 | show p.name;
// => "find" | "p: index person_age for p.age > 0" | 1
// => "where" | "where p.age > 0 (checked at the source)" | null
// => "sort" | "sort p.age desc" | null
// => "limit" | "limit 1" | null
// => "show" | "show p.name" | null
explain find Person p | where search(p.name, "ann") | show p.name;
// warning: search() on p.name has no text index
// => "find" | "p: scan kind Person" | 2
// => "where" | "where search(p.name, \"ann\") (checked at the source)" | null
// => "show" | "show p.name" | null
// => "warning" | "search() on p.name has no text index, so each p's text is matched; define text index … on Person(name) to make it fast" | null
explain find Person p, Company c | where p.name = c.name | show p.name;
// => "find" | "c: scan kind Company" | 1
// => "find" | "p: scan kind Person" | 2
// => "where" | "where p.name = c.name (checked at the source)" | null
// => "show" | "show p.name" | null
explain delete @acme;
// => "delete" | "Company @acme with 1 field"
// => "relations" | "deletes works_at: 1"
// => "would change" | "1 item"
explain delete @ann;
// => "delete" | "Person @ann with 3 fields"
// => "relations" | "deletes likes: 1"
// => "relations" | "deletes works_at: 1"
// => "blocked" | "constraint: #ID is referenced by restrict ref fields [#ID]"
explain update @ann set age = -5;
// => "blocked" | "constraint: Person #ID: check failed for age: age >= 0"
explain update @ann set age = 31;
// => "would change" | "1 item"
find @ann as p | show p.age;
// => 30
explain begin;
// error syntax: explain works on queries and data statements
// => (none)
